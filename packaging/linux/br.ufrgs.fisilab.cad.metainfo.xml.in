<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.cad</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>CAD</name>
  <summary>Desenho técnico e CAD</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O CAD é um aplicativo livre de desenho técnico assistido por computador, com linha de
      comando, snaps a objetos, camadas, cotas, hachuras e blocos. Abre e salva desenhos DXF e
      DWG e exporta SVG e PNG. Faz parte da Suíte FisiLab (alternativa livre).
    </p>
    <p>
      Baseado no CADCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.cad.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.cad</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-cad/issues</url>
  <categories>
    <category>Graphics</category>
    <category>Engineering</category>
  </categories>
  <keywords>
    <keyword>CAD</keyword>
    <keyword>desenho técnico</keyword>
    <keyword>DXF</keyword>
    <keyword>DWG</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9ee3f2</color>
    <color type="primary" scheme_preference="dark">#0b6f88</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>fisilab-cad</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
